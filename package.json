{
  "name": "taskboi-mcp",
  "version": "1.1.0",
  "description": "Portable stdio MCP server for Taskboi task management",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-base-url": {
      "types": "./dist/api-base-url.d.ts",
      "import": "./dist/api-base-url.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "bin": {
    "taskboi-mcp": "./bin/taskboi-mcp.js"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm run check:stdio && npm --prefix workers run check && npm run check:workflows",
    "check:stdio": "npm test && npm audit --omit=dev --audit-level=high",
    "check:workflows": "node scripts/check-workflow-policy.mjs",
    "verify:package": "node --test test/package-contents.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "task-management",
    "taskboi",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1"
  }
}
